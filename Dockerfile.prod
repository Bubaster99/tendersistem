# Рабочий образ: собранный сайт (next build), запуск через next start.
# Запуск на сервере: docker compose -f docker-compose.prod.yml up -d --build
FROM node:22-alpine
ENV TZ=Europe/Moscow \
    NEXT_TELEMETRY_DISABLED=1
RUN apk add --no-cache tzdata
WORKDIR /app
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci --no-audit --no-fund
COPY . .
# Сборка запасным сборщиком (webpack): основной (Turbopack) падает на русских буквах в сообщениях.
RUN NODE_ENV=production npx next build --webpack
ENV NODE_ENV=production
EXPOSE 3000
# При старте: обновить структуру базы, создать справочник видов работ и первого админа, запустить сайт.
CMD ["sh", "-c", "npx prisma migrate deploy && npx prisma db seed && npx next start -H 0.0.0.0 -p 3000"]
