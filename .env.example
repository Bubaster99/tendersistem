# Подключение к базе. В Docker Compose хост базы — db.
DATABASE_URL="postgresql://tender:tender@db:5432/tender?schema=public"

# Секрет для подписи сессий и хэширования кодов. Длинная случайная строка (openssl rand -hex 32).
AUTH_SECRET="замените-на-длинную-случайную-строку"

# Ключ DaData (Подсказки по организациям). Пусто — используются тестовые данные.
DADATA_API_KEY=""

# Email поддержки — показывается, если компания уже зарегистрирована с другим email.
SUPPORT_EMAIL="support@example.ru"

# Email первого администратора — создаётся автоматически при запуске. Вход в админку: /admin/login
ADMIN_EMAIL="aiag22msk@gmail.com"

# Папка для загруженных файлов (документы тендеров, картинки). В Docker задаётся автоматически.
UPLOAD_DIR=""

# Ссылка на Telegram-канал с тендерами (страница «Контакты»). Пусто — «Канал скоро появится».
TELEGRAM_CHANNEL_URL=""

# Адрес сайта (для ссылок в письмах)
APP_URL="http://localhost:3000"

# Почта (SMTP). В режиме разработки письма не отправляются, а печатаются в консоль.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Тендерная площадка <noreply@example.ru>"
