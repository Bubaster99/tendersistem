# Настройки РАБОЧЕГО сервера. Скопируйте в .env на сервере и заполните: cp .env.production.example .env
# Сайт не запустится, если AUTH_SECRET слабый, не заполнена почта или APP_URL без https.

# Адрес площадки (без https://) — на него Caddy получит сертификат HTTPS
DOMAIN="tender.example.ru"
# Тот же адрес с https:// — для ссылок в письмах
APP_URL="https://tender.example.ru"

# POSTGRES_PASSWORD (пароль базы) и AUTH_SECRET (секрет для входа) — случайные строки.
# Их допишет в конец файла команда из DEPLOY.md (шаг 8). Вручную: openssl rand -hex 24 / openssl rand -hex 32

# Первый администратор — создаётся сам при запуске
ADMIN_EMAIL="aiag22msk@gmail.com"
# Email поддержки — показывается подрядчикам
SUPPORT_EMAIL=""

# Почта (SMTP) российского сервиса. Пример для Яндекс 360: smtp.yandex.ru, порт 465,
# логин — полный адрес ящика, пароль — «пароль приложения» из настроек Яндекс ID.
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Тендерная площадка <noreply@example.ru>"

# DaData — реквизиты компании по ИНН (обязательно). Ключ: dadata.ru → Личный кабинет → API-ключ (бесплатно до 10 000 запросов в день)
DADATA_API_KEY=""

# Ссылка на Telegram-канал (необязательно)
TELEGRAM_CHANNEL_URL=""

# Бэкапы: сколько дней хранить (по умолчанию 14)
BACKUP_KEEP_DAYS="14"
# Копия бэкапов в облачное хранилище в РФ (необязательно, но рекомендуется).
# Selectel: endpoint https://s3.ru-1.storage.selcloud.ru, регион ru-1
# Yandex Object Storage: endpoint https://storage.yandexcloud.net, регион ru-central1
BACKUP_S3_BUCKET=""
BACKUP_S3_ENDPOINT=""
BACKUP_S3_REGION=""
BACKUP_S3_ACCESS_KEY=""
BACKUP_S3_SECRET_KEY=""
