generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  new
  checked
  blocked
}

enum UserRole {
  contractor
  buyer
  admin
}

// Подрядчик. Реквизиты подтягиваются из DaData по ИНН.
model Company {
  id         String        @id @default(cuid())
  inn        String        @unique
  kpp        String?
  ogrn       String?
  name       String
  address    String?
  city       String?
  workTypes  String[]      @default([])
  experience String?
  status     CompanyStatus @default(new)
  rating     Int?
  createdAt  DateTime      @default(now())
  users      User[]
  downloads  DocumentDownload[]
  bids       Bid[]
  watches    TenderWatch[]
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  role           UserRole  @default(contractor)
  companyId      String?
  company        Company?  @relation(fields: [companyId], references: [id])
  name           String?
  phone          String?
  telegramChatId String?
  consentPdAt    DateTime?
  createdAt      DateTime  @default(now())
  tenders        Tender[]
}

// Одноразовый код входа: храним только хэш, живёт 10 минут, максимум 5 попыток.
model LoginCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

enum TenderStatus {
  planned
  open
  closed
  rebid
  awarded
  cancelled
}

enum DocumentKind {
  bom_template
  tz
  contract
  drawings
  other
}

// Объект (ЖК).
model Project {
  id          String   @id @default(cuid())
  name        String
  address     String?
  stage       String?
  finishDate  String? // текстом, напр. «IV кв. 2027»
  size        String? // этажность / секции
  coverImage  String? // ключ файла в хранилище
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  tenders     Tender[]
}

// Справочник видов работ.
model WorkType {
  id                   String   @id @default(cuid())
  name                 String   @unique
  responsibleContactId String?
  responsibleContact   Contact? @relation(fields: [responsibleContactId], references: [id], onDelete: SetNull)
  tenders              Tender[]
}

// Снабженцы на странице «Контакты».
model Contact {
  id        String     @id @default(cuid())
  name      String
  role      String?
  scope     String?
  phone     String?
  email     String?
  telegram  String?
  photo     String? // ключ файла в хранилище
  sortOrder Int        @default(0)
  workTypes WorkType[]
  tenders   Tender[]
}

// Тендер. publishedAt = null — черновик, подрядчики его не видят.
model Tender {
  id               String             @id @default(cuid())
  projectId        String
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workTypeId       String
  workType         WorkType           @relation(fields: [workTypeId], references: [id], onDelete: Restrict)
  title            String
  scope            String?
  status           TenderStatus       @default(planned)
  plannedStart     String? // текстом, для «Скоро»: «декабрь 2026»
  deadlineAt       DateTime?
  workStart        String?
  paymentTerms     String?
  retentionPercent Decimal?           @db.Decimal(5, 2)
  contactId        String?
  contact          Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  publishedAt      DateTime?
  createdAt        DateTime           @default(now())
  documents        TenderDocument[]
  downloads        DocumentDownload[]
  bids             Bid[]
  watches          TenderWatch[]

  @@index([projectId])
}

model TenderDocument {
  id         String       @id @default(cuid())
  tenderId   String
  tender     Tender       @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  kind       DocumentKind
  fileKey    String
  fileName   String
  size       Int
  uploadedAt DateTime     @default(now())

  @@index([tenderId])
}

// Кто из подрядчиков скачивал документацию тендера (для счётчика и напоминаний).
model DocumentDownload {
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tenderId  String
  tender    Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  firstAt   DateTime @default(now())
  lastAt    DateTime @default(now())

  @@id([companyId, tenderId])
}

// КП. До дедлайна суммы и файлы не отдаются никому, кроме самой компании (см. src/lib/bids.ts).
// Уникально: (тендер, компания, раунд) — повторная подача заменяет КП, прежняя версия уходит в историю.
model Bid {
  id             String       @id @default(cuid())
  tenderId       String
  tender         Tender       @relation(fields: [tenderId], references: [id], onDelete: Restrict)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  round          Int          @default(1)
  fileKey        String
  fileName       String
  fileSize       Int
  totalWithVat   Decimal      @db.Decimal(15, 2)
  durationDays   Int
  advancePercent Decimal      @db.Decimal(5, 2)
  comment        String?
  submittedAt    DateTime     @default(now()) // первая подача
  replacedAt     DateTime? // последняя замена
  isWithdrawn    Boolean      @default(false)
  versions       BidVersion[]

  @@unique([tenderId, companyId, round])
}

// История замен КП.
model BidVersion {
  id             String   @id @default(cuid())
  bidId          String
  bid            Bid      @relation(fields: [bidId], references: [id], onDelete: Cascade)
  fileKey        String
  fileName       String
  fileSize       Int
  totalWithVat   Decimal  @db.Decimal(15, 2)
  durationDays   Int
  advancePercent Decimal  @db.Decimal(5, 2)
  comment        String?
  submittedAt    DateTime // когда была подана эта версия
  replacedAt     DateTime @default(now()) // когда её заменили

  @@index([bidId])
}

// «Сообщить о старте» для тендера со статусом «Скоро».
model TenderWatch {
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tenderId  String
  tender    Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([companyId, tenderId])
}

// Журнал действий: вход, просмотр/скачивание КП, изменение статуса тендера, выбор победителя.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String
  entity    String?
  entityId  String?
  details   String?
  ip        String?
  at        DateTime @default(now())

  @@index([entity, entityId])
  @@index([at])
}
